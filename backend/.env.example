# AirDose Backend Configuration
OPENAQ_API_KEY=your_openaq_api_key_here
PORT=8000
HOST=0.0.0.0

# ==============================================================================
# AWS Amazon Bedrock AI Exposure Advisor Configuration
# ==============================================================================
# AWS Region where Amazon Bedrock and your chosen foundation model are available
# Recommended regions: ap-south-1 (Mumbai), us-east-1 (N. Virginia), us-west-2 (Oregon)
AWS_REGION=ap-south-1

# Amazon Bedrock Model ID or Inference Profile ARN supporting the Converse API:
# Examples:
#   - Amazon Nova Micro (fast, low-cost): amazon.nova-micro-v1:0
#   - Amazon Nova Lite (multimodal/text): amazon.nova-lite-v1:0
#   - Anthropic Claude 3 Haiku: anthropic.claude-3-haiku-20240307-v1:0
#   - Anthropic Claude 3.5 Sonnet: anthropic.claude-3-5-sonnet-20240620-v1:0
#   - Meta Llama 3 8B Instruct: meta.llama3-8b-instruct-v1:0
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Inference Generation Parameters
BEDROCK_MAX_TOKENS=500
BEDROCK_TEMPERATURE=0.3
BEDROCK_TIMEOUT_SECONDS=15

# ==============================================================================
# AWS Authentication (Zero hardcoded secrets recommended!)
# ==============================================================================
# By default, boto3 uses the AWS default credential provider chain:
#   1. Environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
#   2. AWS CLI credentials profile (~/.aws/credentials configured via `aws configure`)
#   3. IAM Role (EC2 Instance Metadata or ECS/EKS IAM Roles for Service Accounts)
#
# Optional local development overrides (DO NOT commit real keys to Git):
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_SESSION_TOKEN=optional_session_token
